# Copy to .env and fill with your credentials

# Gateway 认证 Token (可选，用于远程 Gateway 或多设备连接)
# 可以通过以下方式配置：
# 1. 环境变量：PANDA_GATEWAY_TOKEN=your_token_here
# 2. 配置文件：~/.panda/panda.json 中设置 gateway.auth.token
# 3. 命令行：panda gateway --token your_token_here
# 生成方式：openssl rand -hex 32
# PANDA_GATEWAY_TOKEN=abcd1234567890abcd1234567890abcd1234567890abcd1234567890abcd1234

# Twilio WhatsApp 配置 (可选，用于 WhatsApp 集成)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# 其他常用环境变量：
# PANDA_STATE_DIR=~/.panda              # 状态目录
# PANDA_CONFIG_PATH=~/.panda/panda.json # 配置文件路径
# PANDA_SKIP_CHANNELS=1                 # 跳过渠道初始化
# PANDA_NIX_MODE=1                      # Nix 模式
# PANDA_NO_RESPAWN=1                    # 禁用进程重启
